# ==========================================================
# BotWA - Application
# ==========================================================

BOTWA_APP_NAME=BotWA Starter
BOTWA_ENVIRONMENT=local
BOTWA_LOG_LEVEL=INFO
BOTWA_API_VERSION=v1

# ==========================================================
# Database
# ==========================================================

BOTWA_DATABASE_URL=postgresql+psycopg://botwa:botwa@db:5432/botwa
BOTWA_USE_DATABASE=false

# ==========================================================
# WhatsApp Cloud API
# ==========================================================

BOTWA_WHATSAPP_WEBHOOK_VERIFY_TOKEN=botwa_verify_token
BOTWA_WHATSAPP_ACCESS_TOKEN=
BOTWA_WHATSAPP_PHONE_NUMBER_ID=
BOTWA_WHATSAPP_API_VERSION=v22.0
BOTWA_WHATSAPP_SECRET_ENCRYPTION_KEY=generate-a-fernet-key-outside-version-control
BOTWA_WHATSAPP_SECRET_PREVIOUS_ENCRYPTION_KEYS=
BOTWA_WHATSAPP_LIVE_CLIENT_MODE=disabled
BOTWA_WHATSAPP_WEBHOOK_MAX_BODY_BYTES=1048576
BOTWA_WHATSAPP_WEBHOOK_MAX_EVENTS=100
BOTWA_WHATSAPP_OUTBOUND_MAX_TEXT_CHARS=4096
BOTWA_WHATSAPP_OUTBOUND_MAX_ATTEMPTS=3
BOTWA_WHATSAPP_OUTBOUND_RETRY_BASE_SECONDS=1
BOTWA_WHATSAPP_OUTBOUND_RETRY_MAX_SECONDS=60
BOTWA_WHATSAPP_META_TIMEOUT_SECONDS=10

# ==========================================================
# Authentication
# ==========================================================

BOTWA_AUTH_SECRET_KEY=replace-with-a-strong-secret-outside-version-control
BOTWA_AUTH_ALGORITHM=HS256
BOTWA_AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
BOTWA_AUTH_PASSWORD_MIN_LENGTH=12
